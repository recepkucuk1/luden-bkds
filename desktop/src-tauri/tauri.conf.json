{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BRY Takip",
  "version": "0.5.9",
  "identifier": "com.brytakip.bkds",
  "build": {
    "frontendDist": "./dist-frontend",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BRY Takip",
        "width": 420,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [],
    "resources": [
      "dist-frontend/**/*",
      "binaries/server.mjs",
      "binaries/brytakip-backend*"
    ],
    "copyright": "© 2026 LudenLab",
    "category": "Productivity",
    "shortDescription": "BKDS anlık takip",
    "longDescription": "Özel eğitim merkezleri için BKDS giriş-çıkış anlık takip uygulaması"
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://brytakip.com/updates/latest.json",
        "https://github.com/recepkucuk1/luden-bkds/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RjlGMDZDMTdDMUVFM0MKUldRODdzRVhiUEQ1cVpoTHFzaHhCbXBsTjRnSUNVWU4zYnhkOEJsMjFmWUFwNjU4RFhBTFRmSWkK"
    }
  }
}
