# Backend port
PORT=8787

# ─── BRY bilgileri (opsiyonel) ──────────────────────────────────
# Yeni kurulumda bu alanlar boş kalabilir.
# Kullanıcı uygulamayı ilk kez açtığında setup wizard ile bilgilerini girer,
# .data/config.json'a şifreli olmasa da güvenli yerde saklanır (Tauri'de OS keychain'e taşınacak).
#
# .env'de değer varsa ve config.json yoksa, env değerleri başlangıç olarak alınır.
INNOVA_BASE_URL=
INNOVA_USERNAME=
INNOVA_PASSWORD=

# Bildirimler tamamen yerel ağda (browser Notification API). Internet üzerinden push yok.
