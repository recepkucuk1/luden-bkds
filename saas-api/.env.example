# Supabase Postgres connection strings
# Project Settings → Database → Connection string
# - DATABASE_URL: "Transaction" mode (port 6543, PgBouncer) — runtime queries
# - DIRECT_URL: "Session" mode (port 5432, direct) — Prisma migrations
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Admin token — admin endpoint'lerine erişim için (uzun random string)
# `openssl rand -hex 32` ile üret, Vercel Dashboard'a koy
ADMIN_TOKEN="paste-a-long-random-hex-string-here"
