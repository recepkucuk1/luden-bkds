# Hostinger MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
#
# hPanel → MySQL Databases → veritabanı oluştur ve user'ı ayar.
# Host: genelde "localhost" Hostinger Node app içinde, dış erişim için
#       hostinger sana ayrı bir hostname verir (örn. mysql.brytakip.com).
#
# Örnek:
#   mysql://u1234567_brytakip:STRONGPASS@localhost:3306/u1234567_brytakip
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"

# Admin token — admin endpoint'lerine erişim için (uzun random string)
# Terminal: `openssl rand -hex 32`
ADMIN_TOKEN="paste-a-long-random-hex-string-here"
