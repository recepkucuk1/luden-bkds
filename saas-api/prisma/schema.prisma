// BRY Takip SaaS API — Prisma schema
// Database: Hostinger MySQL (Business plan)
//
// Migration komutları:
//   npx prisma migrate dev --name <isim>     (dev'de yeni migration)
//   npx prisma migrate deploy                 (production'da uygula)
//   npx prisma studio                         (GUI inspector)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // MySQL'de Prisma direct/pooler ayrımı yok — tek bağlantı
}

// ─── Kurum (kayıt olmuş özel eğitim merkezi) ─────────────────
model Kurum {
  id          String    @id @default(cuid())
  ad          String    @db.VarChar(200)
  yetkili     String    @db.VarChar(100)
  email       String    @unique @db.VarChar(150)
  telefon     String    @db.VarChar(30)
  sehir       String    @db.VarChar(60)
  plan        Plan      @default(LITE)
  source      String?   @db.VarChar(50)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  licenses    License[]
  payments    Payment[]

  @@index([createdAt])
  @@index([plan])
}

enum Plan {
  LITE
  STANDART
  PRO
}

// ─── Lisans (kurum'a verilen anahtar) ───────────────────────
model License {
  id           String         @id @default(cuid())
  kurumId      String
  kurum        Kurum          @relation(fields: [kurumId], references: [id], onDelete: Cascade)
  key          String         @unique @db.VarChar(50)
  machineId    String?        @db.VarChar(100)
  status       LicenseStatus  @default(PENDING)
  issuedAt     DateTime       @default(now())
  expiresAt    DateTime
  lastPingAt   DateTime?
  revokedAt    DateTime?
  revokeReason String?        @db.VarChar(200)

  @@index([kurumId])
  @@index([status])
  @@index([expiresAt])
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

// ─── Ödeme kayıtları ────────────────────────────────────────
model Payment {
  id          String         @id @default(cuid())
  kurumId     String
  kurum       Kurum          @relation(fields: [kurumId], references: [id], onDelete: Cascade)
  amount      Decimal        @db.Decimal(10, 2)
  method      PaymentMethod
  status      PaymentStatus  @default(PENDING)
  receiptUrl  String?        @db.VarChar(500)
  invoiceNo   String?        @db.VarChar(50)
  externalId  String?        @db.VarChar(100)
  paidAt      DateTime?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([kurumId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentMethod {
  HAVALE
  IYZICO
  MANUEL
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
